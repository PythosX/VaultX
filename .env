PORT=4000
NODE_ENV=production
SESSION_SECRET=change-me-long-random
ADMIN_EMAIL=you@example.com
# generate with: npm run hash -- "yourPassword"
ADMIN_PASSWORD_HASH=
# Postgres (Neon / Supabase free tier connection string)
DATABASE_URL=
# S3-compatible storage (Cloudflare R2 or Backblaze B2). Create TWO buckets, both private.
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET_PUBLIC=vaultx-public
STORAGE_BUCKET_PRIVATE=vaultx-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Free hosts have small disk/RAM and request timeouts: keep limits modest
PUBLIC_MAX_FILE_SIZE=104857600
PRIVATE_MAX_FILE_SIZE=104857600
PUBLIC_STORAGE_LIMIT=8589934592
UPLOAD_RATE_LIMIT=30

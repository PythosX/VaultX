NODE_ENV=production

SESSION_SECRET=YOUR_LONG_RANDOM_SECRET

ADMIN_EMAIL=your-email@example.com

ADMIN_PASSWORD_HASH=YOUR_GENERATED_PASSWORD_HASH

DATABASE_URL=YOUR_NEON_DATABASE_URL

STORAGE_ENDPOINT=s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005

STORAGE_BUCKET_PUBLIC=vaultx-public
STORAGE_BUCKET_PRIVATE=vaultx-private

STORAGE_ACCESS_KEY=YOUR_B2_KEY_ID
STORAGE_SECRET_KEY=YOUR_B2_APPLICATION_KEY

PUBLIC_MAX_FILE_SIZE=104857600
PRIVATE_MAX_FILE_SIZE=104857600

PUBLIC_STORAGE_LIMIT=8589934592

UPLOAD_RATE_LIMIT=30
